# Backend API Configuration

# MongoDB Connection
# For local development with Docker:
MONGODB_URI=mongodb://admin:password@localhost:27017/dcms?authSource=admin

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/dcms

# Port
PORT=3000

# Environment
NODE_ENV=development

# JWT Secret (if needed)
JWT_SECRET=your_jwt_secret_key_here

# API Prefix
API_PREFIX=api
