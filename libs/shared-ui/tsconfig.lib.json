{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": false,
    "lib": ["dom", "es2022"]
